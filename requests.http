@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}/health

### Database connectivity
GET {{baseUrl}}/db-check


# ---------------------------------------------------------------
# Products - happy paths
# ---------------------------------------------------------------

### List all products
GET {{baseUrl}}/products

### Get one product
GET {{baseUrl}}/products/1

### Create a product -> 201
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Enamel Pin",
  "description": "Hard enamel, butterfly clasp",
  "price_cents": 650,
  "stock": 80
}

### Replace a product -> 200
PUT {{baseUrl}}/products/1
Content-Type: application/json

{
  "name": "Ceramic Mug",
  "description": "Hand-thrown stoneware mug, 350ml",
  "price_cents": 1395,
  "stock": 38
}

### Delete a product -> 204
DELETE {{baseUrl}}/products/6


# ---------------------------------------------------------------
# Products - failure paths
# ---------------------------------------------------------------

### No such product -> 404
GET {{baseUrl}}/products/9999

### Non-numeric id -> 400
GET {{baseUrl}}/products/banana

### Blank name -> 400
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "",
  "price_cents": 500
}

### Negative price -> 400
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Bad Price",
  "price_cents": -5
}

### Fractional price -> 400 (prices are integer cents, 9.99 should be 999)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Float Price",
  "price_cents": 9.99
}

### Missing price entirely -> 400
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "No Price"
}


# ---------------------------------------------------------------
# Users
# ---------------------------------------------------------------

### Register -> 201 (note: no password_hash in the response)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "tyler@example.com",
  "password": "correct-horse-battery-staple"
}

### Register a second user -> 201
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "second@example.com",
  "password": "password"
}


### Same email again -> 409
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "tyler@example.com",
  "password": "correct-horse-battery-staple"
}

### Malformed email -> 400
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "correct-horse-battery-staple"
}

### Password too short -> 400
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "someone@example.com",
  "password": "short"
}

### Get a user -> 200, and NO password_hash in the body
GET {{baseUrl}}/users/1

### No such user -> 404
GET {{baseUrl}}/users/9999

### Update a user -> 200
PUT {{baseUrl}}/users/1
Content-Type: application/json

{
  "email": "tyler.updated@example.com",
  "password": "a-different-password"
}

### Update a user that does not exist -> 404
PUT {{baseUrl}}/users/9999
Content-Type: application/json

{
  "email": "ghost@example.com",
  "password": "a-different-password"
}

### Log in -> 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "tyler.updated@example.com",
  "password": "a-different-password"
}

### Wrong password -> 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "tyler.updated@example.com",
  "password": "wrong"
}

### Unknown email -> 401, same message
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "whatever"
}

### Who am I -> 200 if logged in
GET {{baseUrl}}/auth/me

### Log out -> 204
POST {{baseUrl}}/auth/logout

### My cart -> 200, empty to start
GET {{baseUrl}}/cart

### Add to cart -> 201
POST {{baseUrl}}/cart/items
Content-Type: application/json

{
  "product_id": 1,
  "quantity": 2
}

### Add the same product again -> 201, quantity becomes 4
POST {{baseUrl}}/cart/items
Content-Type: application/json

{
  "product_id": 1,
  "quantity": 2
}

### Product that does not exist -> 404
POST {{baseUrl}}/cart/items
Content-Type: application/json

{
  "product_id": 9999,
  "quantity": 1
}

### Set an exact quantity -> 200 (PUT sets, POST adds)
PUT {{baseUrl}}/cart/items/1
Content-Type: application/json

{
  "quantity": 5
}

### Set quantity on a product not in the cart -> 404
PUT {{baseUrl}}/cart/items/4
Content-Type: application/json

{
  "quantity": 5
}

### Quantity of zero -> 400 (use DELETE to remove a line)
PUT {{baseUrl}}/cart/items/1
Content-Type: application/json

{
  "quantity": 0
}

### Remove one line -> 204
DELETE {{baseUrl}}/cart/items/1

### Remove the same line again -> 404
DELETE {{baseUrl}}/cart/items/1

### Non-numeric product id -> 400
DELETE {{baseUrl}}/cart/items/banana

### Empty the whole cart -> 204
DELETE {{baseUrl}}/cart

### Empty an already-empty cart -> 204 (idempotent, not a 404)
DELETE {{baseUrl}}/cart


# ---------------------------------------------------------------
# Orders (all require login)
# ---------------------------------------------------------------

### Checkout with an empty cart -> 400
POST {{baseUrl}}/orders

### Put something in the cart first
POST {{baseUrl}}/cart/items
Content-Type: application/json

{
  "product_id": 1,
  "quantity": 2
}

### Place the order -> 201 (empties cart, decrements stock)
POST {{baseUrl}}/orders

### My orders, newest first -> 200
GET {{baseUrl}}/orders

### One order with its line items -> 200
GET {{baseUrl}}/orders/1

### An order that is not yours -> 404 (not 403 - we do not reveal it exists)
GET {{baseUrl}}/orders/9999

### Update the status -> 200
PUT {{baseUrl}}/orders/1
Content-Type: application/json

{
  "status": "paid"
}

### Unrecognised status -> 400
PUT {{baseUrl}}/orders/1
Content-Type: application/json

{
  "status": "banana"
}

### Delete an order -> 204 (returns the stock)
DELETE {{baseUrl}}/orders/1
